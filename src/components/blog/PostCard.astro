---
// One post in the blog listings. The title is the only link; its ::after covers the whole card so
// the card is clickable without nesting links. `featured` is the large lead card.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../FormattedDate.astro';
import { categoryOf, readingTime } from '../../lib/posts';

interface Props {
	post: CollectionEntry<'blog'>;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, draft } = post.data;
const Heading = featured ? 'h2' : 'h3';
---

<article class:list={['card', { featured, 'with-image': featured && heroImage }]}>
	{heroImage && <Image class="cover" src={heroImage} width={featured ? 960 : 640} height={featured ? 540 : 360} alt="" />}
	<div class="body">
		<Heading class="title">
			<a href={`/blog/${post.id}/`}>{title}</a>
		</Heading>
		<p class="excerpt">{description}</p>
		<p class="meta">
			<span class="cat">{categoryOf(post).name}</span>
			<FormattedDate date={pubDate} />
			<span aria-hidden="true">·</span>
			<span>{readingTime(post.body)} min</span>
			{draft && <span class="draft">Borrador</span>}
		</p>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		border: 1px solid var(--brand-line);
		border-radius: 8px;
		overflow: hidden;
		transition: border-color 160ms ease-out;
	}
	.card:hover,
	.card:focus-within {
		border-color: var(--brand-dark);
	}
	.cover {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
	}
	.body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 24px;
	}
	.title {
		margin: 0 0 12px;
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}
	.title a {
		color: var(--brand-dark);
		text-decoration: none;
	}
	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.title a:focus-visible {
		outline: none;
	}
	.card:has(.title a:focus-visible) {
		outline: 2px solid var(--brand-accent);
		outline-offset: 2px;
	}
	.excerpt {
		display: -webkit-box;
		margin: 0 0 24px;
		overflow: hidden;
		color: var(--brand-graphite);
		font-size: 16px;
		line-height: 1.6;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 8px;
		margin: auto 0 0;
		color: var(--brand-graphite);
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.5;
	}
	.cat {
		flex-basis: 100%;
		color: var(--brand-dark);
	}
	.draft {
		padding: 0 6px;
		border: 1px solid var(--brand-line-strong);
		border-radius: 4px;
	}

	/* Lead card: bigger title and room to breathe; with a cover, text and image side by side. */
	.featured .body {
		padding: 40px;
	}
	.featured .title {
		max-width: 820px;
		font-size: 32px;
		letter-spacing: -0.015em;
		line-height: 1.2;
	}
	.featured .excerpt {
		max-width: 680px;
		font-size: 20px;
		line-height: 1.5;
		-webkit-line-clamp: 4;
	}
	@media (min-width: 900px) {
		.with-image {
			display: grid;
			grid-template-columns: 1fr 1fr;
		}
		.with-image .cover {
			order: 2;
			height: 100%;
			object-fit: cover;
		}
	}
	@media (max-width: 600px) {
		.body,
		.featured .body {
			padding: 20px;
		}
		.featured .title {
			font-size: 24px;
		}
		.featured .excerpt {
			font-size: 17px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
	}
</style>
