---
// The ink band that sends blog readers to the pillar guide (the blog's «start here»). Renders
// nothing if the guide is not published.
import { getGuides, readingTime } from '../../lib/posts';

const GUIDE_ID = 'como-hacer-programacion-didactica-fp';
const guide = (await getGuides()).find((g) => g.id === GUIDE_ID);
---

{
	guide && (
		<section class="band" aria-labelledby="band-title">
			<h2 id="band-title" class="band-title">
				<a href={`/${guide.id}/`}>{guide.data.title}</a>
			</h2>
			<p class="band-text">
				Las cinco fases en las que construyo una programación, las decisiones que toma y cómo comprobar que cada
				apartado aguanta la pregunta «¿por qué?». Si empiezas por algo, empieza por aquí.
			</p>
			<p class="band-foot">
				<span class="band-cta" aria-hidden="true">Leer la guía</span>
				<span class="band-kind">Guía completa · {readingTime(guide.body)} min de lectura</span>
			</p>
		</section>
	)
}

<style>
	.band {
		position: relative;
		padding: 48px;
		border-radius: 8px;
		background: var(--brand-dark);
		color: var(--brand-light);
	}
	.band-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 8px 24px;
		margin: 0;
	}
	.band-kind {
		color: var(--brand-on-dark);
		font-family: var(--font-mono);
		font-size: 14px;
	}
	.band-title {
		max-width: 820px;
		margin: 0 0 16px;
		color: var(--brand-light);
	}
	.band-title a {
		color: inherit;
		text-decoration: none;
	}
	.band-title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.band-title a:focus-visible {
		outline: none;
	}
	.band:has(.band-title a:focus-visible) {
		outline: 2px solid var(--brand-accent-on-dark);
		outline-offset: 2px;
	}
	.band-text {
		max-width: 680px;
		margin: 0 0 24px;
		color: var(--brand-on-dark);
	}
	.band-cta {
		color: var(--brand-accent-on-dark);
		font-weight: 500;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.band:hover .band-cta {
		color: var(--brand-light);
	}
	@media (max-width: 600px) {
		.band {
			padding: 32px 20px;
		}
	}
</style>
