---
// Effort vs. impact on the defence, as a 2×2. Ginés's judgement, not a measurement.
const quads = [
	{ title: 'Primero', axis: 'Poco esfuerzo · mucho impacto', items: ['Secuencia de unidades', 'Contextualización útil', 'Fundamentación', 'Medidas de inclusión'], key: true },
	{ title: 'Planificar con tiempo', axis: 'Mucho esfuerzo · mucho impacto', items: ['Matriz RA–UT', 'Pesos de los CE'] },
	{ title: 'Resolver rápido', axis: 'Poco esfuerzo · poco impacto', items: ['Listado de recursos'] },
	{ title: 'Limitar el tiempo', axis: 'Mucho esfuerzo · poco impacto', items: ['Actividades detalladas', 'Maquetación'] },
];
---

<figure class="prio">
	<div class="grid">
		{
			quads.map((q) => (
				<div class:list={['quad', { key: q.key }]}>
					<p class="title">{q.title}</p>
					<p class="axis">{q.axis}</p>
					<ul>
						{q.items.map((i) => (
							<li>{i}</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
	<figcaption>Dónde poner el tiempo según lo que pide cada apartado y lo que aporta a la defensa. Es mi criterio, no una medición.</figcaption>
</figure>

<style>
	.prio {
		margin: 32px 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
	}
	.quad {
		padding: 16px;
		border: 1px solid var(--brand-line-strong);
		border-radius: 8px;
	}
	.key {
		border: 2px solid var(--brand-accent);
	}
	.title {
		margin: 0;
		font-weight: 600;
	}
	.key .title {
		color: var(--brand-accent);
	}
	.axis {
		margin: 2px 0 12px;
		color: var(--brand-graphite);
		font-family: var(--font-mono);
		font-size: 13px;
	}
	ul {
		margin: 0;
		padding-left: 20px;
		font-size: 15px;
	}
	figcaption {
		margin-top: 16px;
		color: var(--brand-graphite);
		font-size: 15px;
		line-height: 1.5;
	}
	@media (max-width: 600px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
