---
// The five phases in the order Ginés builds a programación. The dashed bracket under phases 2–3 is
// the step back: designing the evaluation usually means regrouping some unit.
const phases = ['Norma y contexto', 'Concreción curricular', 'Diseño de la evaluación', 'Metodología e inclusión', 'Fundamentación'];
---

<figure class="phases">
	<ol>
		{
			phases.map((p, i) => (
				<li class:list={['phase', { key: i === 2 }]}>
					<span class="n">{i + 1}</span>
					<span class="label">{p}</span>
				</li>
			))
		}
	</ol>
	<div class="back" aria-hidden="true"><span>la 3 ajusta la 2</span></div>
	<figcaption>
		Se avanza de izquierda a derecha. Al diseñar la evaluación casi siempre vuelves atrás a reagrupar alguna unidad. La
		justificación y la introducción se escriben al final.
	</figcaption>
</figure>

<style>
	.phases {
		margin: 32px 0;
	}
	ol {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.phase {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px 12px;
		border: 1px solid var(--brand-line-strong);
		border-radius: 8px;
	}
	.n {
		color: var(--brand-graphite);
		font-family: var(--font-mono);
		font-size: 14px;
	}
	.label {
		font-size: 15px;
		font-weight: 600;
		line-height: 1.3;
		hyphens: auto;
	}
	.key {
		border: 2px solid var(--brand-accent);
	}
	.key .n {
		color: var(--brand-accent);
	}
	/* Bracket under columns 2–3, open at the top: the way back. */
	.back {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 8px;
		height: 32px;
	}
	.back span {
		grid-column: 2 / 4;
		margin: 0 24%;
		border: 1px dashed var(--brand-line-strong);
		border-top: 0;
		border-radius: 0 0 8px 8px;
		color: var(--brand-graphite);
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1;
		text-align: center;
		transform: translateY(-1px);
		padding-top: 10px;
	}
	figcaption {
		margin-top: 8px;
		color: var(--brand-graphite);
		font-size: 15px;
		line-height: 1.5;
	}
	/* Phone: a vertical list; the bracket becomes a line of text under phase 3. */
	@media (max-width: 600px) {
		ol {
			grid-template-columns: minmax(0, 1fr);
		}
		.phase {
			flex-direction: row;
			align-items: baseline;
			gap: 16px;
			padding: 12px 16px;
		}
		.back {
			display: none;
		}
		figcaption {
			margin-top: 16px;
		}
	}
</style>
