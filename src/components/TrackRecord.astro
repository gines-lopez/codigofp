---
// "Mis dos convocatorias" card: 2023 near miss vs. 2025 score.
// `compact` stacks every row while the card is narrower than 480px (side columns).
// `showPast={false}` drops the 2023 row, for pages whose H1 already tells it.
// `showSince` adds the «Desde entonces» row (PROOF_SINCE) under the 2025 one; `sinceDetail` uses
// its longer wording, with the specialties.
// `columns` keeps label | content in two columns at any width, with the 9,6 above its text.
// `photo` (a real photo of Ginés, imported from src/assets) shows next to the signature; without
// it the signature stays text only.
// `showFoot={false}` drops the signature row, for pages that already sign at the end.
// `headingLevel={3}` when the card sits inside a section that already has an H2.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { PROOF_2025, PROOF_SINCE } from '../consts';

interface Props {
	compact?: boolean;
	showPast?: boolean;
	showSince?: boolean;
	sinceDetail?: boolean;
	columns?: boolean;
	photo?: ImageMetadata;
	showFoot?: boolean;
	headingLevel?: 2 | 3;
	class?: string;
}

const {
	compact = false,
	showPast = true,
	showSince = false,
	sinceDetail = false,
	columns = false,
	photo,
	showFoot = true,
	headingLevel = 2,
	class: className,
} = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
const head = showPast ? 'Mis dos convocatorias' : 'Mi última convocatoria';
---

<section class:list={['record', { compact, columns, 'with-since': showSince }, className]} aria-label={head}>
	<Heading class="record-head">
		<span>{head}</span><span class="record-place"
			><span class="record-sep" aria-hidden="true"> · </span>Informática · Comunitat Valenciana</span
		>
	</Heading>
	{
		showPast && (
			<div class="record-row record-past">
				<p class="record-year">2023</p>
				<p class="record-text">
					Me quedé a <strong>0,13</strong> de la plaza con una programación que cumplía con todo.
				</p>
			</div>
		)
	}
	<div class="record-row record-now">
		<p class="record-year">2025</p>
		<div class="record-result">
			<span class="record-score">{PROOF_2025.score}</span>
			<p class="record-text">
				En la defensa de la programación didáctica: {PROOF_2025.best}. {PROOF_2025.rank}.
			</p>
		</div>
	</div>
	{
		showSince && (
			<div class="record-row record-since">
				<p class="record-year">{PROOF_SINCE.label}</p>
				<p class="record-text">
					<strong>{PROOF_SINCE.count}</strong> {sinceDetail ? PROOF_SINCE.detail : PROOF_SINCE.text}
				</p>
			</div>
		)
	}
	{
		showFoot && (
			<div class="record-foot">
				{photo && <Image class="record-photo" src={photo} alt="Ginés" width={48} height={48} />}
				<p>Ginés · docente de FP y funcionario de carrera</p>
			</div>
		)
	}
</section>

<style>
	.record {
		display: flex;
		flex-direction: column;
		min-width: 0;
		box-sizing: border-box;
		border: 1px solid var(--brand-line);
		border-radius: 8px;
		color: var(--brand-dark);
	}
	.record p,
	.record-head {
		margin: 0;
	}
	.record-head {
		padding: 16px 24px;
		border-bottom: 1px solid var(--brand-line);
		color: var(--brand-dark);
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.4;
	}
	.record-head span {
		white-space: nowrap;
	}
	/* Narrow card (any variant): the place goes on its own line instead of wrapping with a
	   dangling dot. The record is its own size container for this one rule. */
	.record {
		container-type: inline-size;
	}
	@container (max-width: 479px) {
		.record-place {
			display: block;
			color: var(--brand-graphite);
		}
		.record-sep {
			display: none;
		}
	}
	.record-row {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 8px 24px;
		padding: 24px;
	}
	.record-year {
		flex: 0 0 72px;
		font-size: 24px;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.2;
	}
	.record-text {
		flex: 1 1 260px;
		font-size: 17px;
		line-height: 1.6;
	}
	.record-past {
		border-bottom: 1px solid var(--brand-line);
		color: var(--brand-graphite);
	}
	.record-past strong {
		color: var(--brand-dark);
	}
	.record-since {
		border-top: 1px solid var(--brand-line);
	}
	/* «Desde entonces» is longer than a year: every row gets the wider label column, so all the
	   texts start on the same vertical line. */
	.with-since .record-year {
		flex-basis: 7.5em;
	}
	/* Too narrow for label + 9,6 + text on one line (180 + 24 + 360 + 48): every row stacks the same
	   way, label on top, so no row is laid out differently from the others. */
	@container (max-width: 619px) {
		.with-since .record-row {
			flex-direction: column;
			flex-wrap: nowrap;
		}
		.with-since .record-year,
		.with-since .record-text,
		.with-since .record-result {
			flex: none;
		}
		.with-since .record-result {
			flex-direction: column;
			align-items: flex-start;
		}
	}
	.record-result {
		display: flex;
		flex: 1 1 360px;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 24px;
	}
	.record-score {
		color: var(--brand-accent);
		font-size: 88px;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
	}
	.record-foot {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 16px 24px;
		border-top: 1px solid var(--brand-line);
		color: var(--brand-graphite);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.5;
	}
	.record-photo {
		flex: 0 0 auto;
		width: 48px;
		height: 48px;
		border-radius: 8px;
		object-fit: cover;
	}

	/* Narrow column: everything stacked, the 2025 row takes the leftover height. */
	.compact {
		container-type: inline-size;
	}
	/* Side column: smaller type and padding so the whole card fits on the first screen. */
	.compact .record-head {
		padding: 12px 16px;
		font-size: 13px;
	}
	.compact .record-row {
		gap: 4px 16px;
		padding: 16px;
	}
	.compact .record-year {
		font-size: 17px;
	}
	.compact .record-text {
		font-size: 15px;
		line-height: 1.5;
	}
	.compact .record-score {
		font-size: 56px;
	}
	.compact .record-foot {
		padding: 12px 16px;
		font-size: 13px;
	}
	@container (max-width: 479px) {
		.compact .record-row {
			flex-direction: column;
			flex-wrap: nowrap;
		}
		.compact .record-year,
		.compact .record-text,
		.compact .record-result {
			flex: none;
		}
		.compact .record-now {
			flex: 1;
			justify-content: center;
		}
		.compact .record-result {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	/* `columns`: always two columns (label | content) at any width, the 9,6 above its text, and every
	   text starting on the same vertical line. Goes after the stacking rules so it wins over them. */
	.columns .record-row {
		flex-direction: row;
		flex-wrap: nowrap;
	}
	.columns .record-year {
		flex: 0 0 7.5em;
	}
	.columns .record-text,
	.columns .record-result {
		flex: 1 1 auto;
		min-width: 0;
	}
	.columns .record-result {
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
	}
	.columns .record-now {
		justify-content: flex-start;
	}
	/* Phone-width card: a narrower label column («Desde entonces» goes on two lines). */
	@container (max-width: 479px) {
		.columns .record-year {
			flex-basis: 88px;
		}
	}

	@media (max-width: 600px) {
		.record-head,
		.record-row,
		.record-foot {
			padding-right: 16px;
			padding-left: 16px;
		}
		.record-score {
			font-size: 72px;
		}
	}
</style>
