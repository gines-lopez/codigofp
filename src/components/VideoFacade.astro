---
// YouTube video as an ink poster that only becomes an iframe (youtube-nocookie.com) on click:
// nothing is requested from YouTube until the visitor presses play. Without JS the poster stays a
// plain link to the video. Used in /dentro-claustro (lead magnet) and /sobre-mi.
interface Props {
	id: string;
	title: string;
	duration: string; // Shown on the poster, e.g. «6 min».
	durationLabel: string; // Read by screen readers, e.g. «6 minutos».
	label?: string; // Mono line above the question, e.g. «// la pregunta del tribunal, 2025».
	question?: string; // Hidden on a phone: no room for it in a 16:9 poster.
	class?: string;
}

const { id, title, duration, durationLabel, label, question, class: className } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
---

<div class:list={['video', className]} data-video-id={id} data-video-title={title}>
	<a class="video-facade" href={watchUrl} target="_blank" rel="noopener">
		<span class="video-head">
			<span class="video-title">{title}</span>
			{
				question && (
					<span class="video-question">
						{label && <span class="video-question-label">{label}</span>}
						{question}
					</span>
				)
			}
		</span>
		<span class="video-play" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="24" height="24" focusable="false">
				<path d="M8 5.5v13a.5.5 0 0 0 .77.42l10.2-6.5a.5.5 0 0 0 0-.84L8.77 5.08A.5.5 0 0 0 8 5.5Z" fill="currentColor"></path>
			</svg>
		</span>
		<span class="video-duration" aria-hidden="true">{duration}</span>
		<span class="sr-only">. Reproducir vídeo, {durationLabel}</span>
	</a>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.video[data-video-id]').forEach((video) => {
		const facade = video.querySelector<HTMLAnchorElement>('.video-facade');
		if (!facade) return;
		facade.removeAttribute('target');
		facade.addEventListener('click', (event) => {
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
			event.preventDefault();
			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${video.dataset.videoId}?autoplay=1&rel=0&modestbranding=1`;
			iframe.title = video.dataset.videoTitle ?? 'Vídeo';
			iframe.allow =
				'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.allowFullscreen = true;
			iframe.referrerPolicy = 'strict-origin-when-cross-origin';
			video.replaceChildren(iframe);
			video.classList.add('is-playing');
			iframe.focus();
		});
	});
</script>

<style>
	.video {
		position: relative;
		margin: 8px 0;
		overflow: hidden;
		border-radius: 8px;
		background: var(--brand-dark);
		aspect-ratio: 16 / 9;
	}
	.video :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.video-facade {
		display: flex;
		position: absolute;
		inset: 0;
		flex-direction: column;
		justify-content: space-between;
		box-sizing: border-box;
		padding: 32px;
		color: var(--brand-light);
		text-decoration: none;
	}
	.video-facade:hover {
		color: var(--brand-light);
	}
	.video-facade:focus-visible {
		outline: 2px solid var(--brand-accent-on-dark);
		outline-offset: -6px;
		border-radius: 8px;
	}
	.video-title {
		max-width: 20ch;
		font-size: 32px;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.2;
		text-wrap: balance;
	}
	.video-head {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	/* The question the video opens with: what the visitor is about to hear, not decoration. */
	.video-question {
		display: flex;
		flex-direction: column;
		gap: 4px;
		max-width: 44ch;
		color: var(--brand-on-dark);
		font-size: 17px;
		line-height: 1.45;
	}
	.video-question-label {
		color: var(--brand-accent-on-dark);
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.4;
	}
	.video-play {
		display: grid;
		width: 64px;
		height: 64px;
		place-items: center;
		border-radius: 50%;
		background: var(--brand-accent-on-dark);
		color: var(--brand-dark);
		transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.video-play svg {
		margin-left: 3px;
	}
	.video-facade:hover .video-play,
	.video-facade:focus-visible .video-play {
		transform: scale(1.08);
	}
	.video-duration {
		position: absolute;
		right: 32px;
		bottom: 32px;
		color: var(--brand-on-dark);
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.4;
	}
	@media (prefers-reduced-motion: reduce) {
		.video-play {
			transition: none;
		}
	}
	@media (max-width: 600px) {
		.video-facade {
			padding: 16px;
		}
		.video-title {
			font-size: 20px;
		}
		.video-question {
			display: none;
		}
		.video-play {
			width: 48px;
			height: 48px;
		}
		.video-duration {
			right: 16px;
			bottom: 16px;
			font-size: 13px;
		}
	}
</style>
