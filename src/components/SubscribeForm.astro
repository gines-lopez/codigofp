---
// Kit (ConvertKit) inline form. The markup is kept verbatim in kit-form.html
// so it can be replaced by pasting a new embed code from Kit.
import formHtml from './kit-form.html?raw';
---

<div class="subscribe">
	<Fragment set:html={formHtml} />
</div>
<script is:inline async src="https://f.convertkit.com/ckjs/ck.5.js"></script>
<style>
	.subscribe :global(.formkit-form[data-uid='d1972e390f']) {
		max-width: 640px;
		margin: 0 auto;
		font-family: inherit;
	}
	.subscribe :global(.formkit-form[data-uid='d1972e390f'] .formkit-input),
	.subscribe :global(.formkit-form[data-uid='d1972e390f'] .formkit-submit) {
		font-family: inherit;
	}
	/* Kit only lays out email + button in a row at 700px+; keep the row on desktop. */
	@media (min-width: 601px) {
		.subscribe :global(.formkit-form[data-uid='d1972e390f'] .formkit-fields) {
			flex-wrap: nowrap;
			gap: 10px;
		}
		.subscribe :global(.formkit-form[data-uid='d1972e390f'] .formkit-field) {
			flex: 1 1 auto;
		}
		.subscribe :global(.formkit-form[data-uid='d1972e390f'] .formkit-submit) {
			flex: 0 0 auto;
		}
	}
</style>
