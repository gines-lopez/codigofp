---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE}. Todos los derechos reservados.
</footer>
<style>
	footer {
		padding: 32px 16px;
		background: var(--brand-dark);
		color: var(--brand-on-dark);
		text-align: center;
		font-size: 14px;
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1.5;
	}
	footer :global(a) {
		color: var(--brand-accent-on-dark);
	}
	@media (max-width: 600px) {
		footer {
			font-size: 13px;
		}
	}
</style>
