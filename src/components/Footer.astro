---
import { SITE_TITLE } from '../consts';

// `showAbout` adds the «Sobre mí» link. Off by default so the ad landings keep a single way out.
interface Props {
	showAbout?: boolean;
}

const { showAbout = false } = Astro.props;
const today = new Date();
const path = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) => (path === href ? 'page' : undefined);
---

<footer>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. Todos los derechos reservados.</p>
	<p>
		{showAbout && <><a href="/sobre-mi/" aria-current={current('/sobre-mi/')}>Sobre mí</a> · </>}<a href="/aviso-legal/" aria-current={current('/aviso-legal/')}>Aviso legal</a> · <a href="/politica-privacidad/" aria-current={current('/politica-privacidad/')}>Política de privacidad</a>
	</p>
</footer>
<style>
	footer {
		padding: 32px 16px;
		background: var(--brand-dark);
		color: var(--brand-on-dark);
		text-align: center;
		font-size: 14px;
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1.5;
	}
	footer p {
		margin: 0;
	}
	footer p + p {
		margin-top: 8px;
	}
	/* Inline-block with 4px of padding: every link is at least 24px tall (WCAG 2.2 target size). */
	footer :global(a) {
		display: inline-block;
		padding: 4px 0;
		color: var(--brand-accent-on-dark);
	}
	footer :global(a[aria-current='page']) {
		color: var(--brand-light);
		text-decoration: none;
	}
	@media (max-width: 600px) {
		footer {
			font-size: 13px;
		}
	}
</style>
