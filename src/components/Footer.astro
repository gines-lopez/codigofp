---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. Todos los derechos reservados.</p>
	<p>
		<a href="/aviso-legal/">Aviso legal</a> · <a href="/politica-privacidad/">Política de privacidad</a>
	</p>
</footer>
<style>
	footer {
		padding: 32px 16px;
		background: var(--brand-dark);
		color: var(--brand-on-dark);
		text-align: center;
		font-size: 14px;
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1.5;
	}
	footer p {
		margin: 0;
	}
	footer p + p {
		margin-top: 8px;
	}
	footer :global(a) {
		color: var(--brand-accent-on-dark);
	}
	@media (max-width: 600px) {
		footer {
			font-size: 13px;
		}
	}
</style>
