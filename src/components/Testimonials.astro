---
// Real testimonials only (PRODUCT.md forbids inventing them): each one is a literal quote with
// name, specialty, region and the year of the plaza. With an empty list nothing is rendered.
// Format: «[quote]» — [name], [specialty], [region], plaza en [year]
interface Testimonial {
	quote: string;
	name: string;
	specialty: string;
	region: string;
	year: number;
}

interface Props {
	items: Testimonial[];
	class?: string;
}

const { items, class: className } = Astro.props;
---

{
	items.length > 0 && (
		<section class:list={['testimonials', className]} aria-label="Testimonios">
			{items.map((item) => (
				<figure class="testimonial">
					<blockquote>
						<p>«{item.quote}»</p>
					</blockquote>
					<figcaption>
						— {item.name}, {item.specialty}, {item.region}, plaza en {item.year}
					</figcaption>
				</figure>
			))}
		</section>
	)
}

<style>
	.testimonials {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.testimonial {
		margin: 0;
		padding: 24px;
		border: 1px solid var(--brand-line);
		border-radius: 8px;
	}
	.testimonial blockquote {
		margin: 0;
		padding: 0;
		border: 0;
	}
	.testimonial p {
		margin: 0;
		color: var(--brand-dark);
		font-size: 17px;
		line-height: 1.6;
	}
	.testimonial figcaption {
		margin-top: 8px;
		color: var(--brand-graphite);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.5;
	}
	@media (max-width: 600px) {
		.testimonial {
			padding: 16px;
		}
	}
</style>
