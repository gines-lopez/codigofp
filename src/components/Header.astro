---
// `linkLogo={false}` shows the wordmark without the link to the home and without the menu (ad
// landings: a single way out). Everywhere else the menu shows the pillar guide and the blog.
interface Props {
	linkLogo?: boolean;
}

const { linkLogo = true } = Astro.props;
const path = Astro.url.pathname;
const menu = [
	{ href: '/como-hacer-programacion-didactica-fp/', label: 'Hacer una PD de FP' },
	{ href: '/blog/', label: 'Blog' },
];
---

<header>
	<nav>
		<!-- Wordmark in text, never an image: "<Código" in ink, "FP>" in cobalt. -->
		{
			linkLogo ? (
				<a href="/" class="brand-wordmark" aria-label="CódigoFP, inicio">&lt;Código<span class="brand-wordmark__fp">FP&gt;</span></a>
			) : (
				<span class="brand-wordmark" role="img" aria-label="CódigoFP">&lt;Código<span class="brand-wordmark__fp">FP&gt;</span></span>
			)
		}
		{
			linkLogo && (
				<ul class="menu">
					{menu.map((m) => (
						<li>
							<a href={m.href} aria-current={path.startsWith(m.href) ? 'page' : undefined}>
								{m.label}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</nav>
</header>
<style>
	header {
		padding: 0 16px;
		background: var(--header-bg, var(--brand-light));
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 24px;
		max-width: 1156px;
		margin: 0 auto;
		padding: 16px 0;
	}
	.brand-wordmark {
		color: var(--brand-dark);
		font-family: var(--font-inter);
		font-size: 24px;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 32px;
		text-decoration: none;
	}
	.brand-wordmark:hover {
		color: var(--brand-dark);
	}
	.brand-wordmark__fp {
		color: var(--brand-accent);
	}
	.menu {
		display: flex;
		gap: 24px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.menu a {
		display: inline-block;
		padding: 8px 0;
		color: var(--brand-graphite);
		font-size: 16px;
		font-weight: 500;
		line-height: 1.5;
		text-decoration: none;
	}
	.menu a:hover {
		color: var(--brand-dark);
	}
	.menu a[aria-current='page'] {
		color: var(--brand-dark);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}
	@media (max-width: 600px) {
		.brand-wordmark {
			font-size: 22px;
		}
	}
</style>
