---
// `linkLogo={false}` shows the wordmark without the link to the home and without the menu (ad
// landings: a single way out). Everywhere else the menu shows the pillar guides and the blog.
interface Props {
	linkLogo?: boolean;
}

const { linkLogo = true } = Astro.props;
const path = Astro.url.pathname;
const menu = [
	{ href: '/como-hacer-programacion-didactica-fp/', label: 'Hacer una PD de FP' },
	{ href: '/como-evaluar-en-fp/', label: 'Evaluar en FP' },
	{ href: '/defensa-programacion-didactica-fp/', label: 'Defender una PD' },
	{ href: '/landing/', label: 'Newsletter', hideOnPhone: true },
	{ href: '/blog/', label: 'Blog' },
];
---

<header>
	<nav>
		<!-- Wordmark in text, never an image: "<Código" in ink, "FP>" in cobalt. -->
		{
			linkLogo ? (
				<a href="/" class="brand-wordmark" aria-label="CódigoFP, inicio">&lt;Código<span class="brand-wordmark__fp">FP&gt;</span></a>
			) : (
				<span class="brand-wordmark" role="img" aria-label="CódigoFP">&lt;Código<span class="brand-wordmark__fp">FP&gt;</span></span>
			)
		}
		{
			linkLogo && (
				<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu" aria-label="Abrir menú">
					<svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16" />
					</svg>
					<svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path d="M6 6l12 12M18 6L6 18" />
					</svg>
				</button>
			)
		}
		{
			linkLogo && (
				<ul class="menu" id="site-menu">
					{menu.map((m) => (
						<li class:list={{ 'hide-phone': m.hideOnPhone }}>
							<a href={m.href} aria-current={path.startsWith(m.href) ? 'page' : undefined}>
								{m.label}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</nav>
</header>
<style>
	header {
		padding: 0 16px;
		background: var(--header-bg, var(--brand-light));
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 24px;
		max-width: 1156px;
		margin: 0 auto;
		padding: 16px 0;
	}
	.brand-wordmark {
		color: var(--brand-dark);
		font-family: var(--font-inter);
		font-size: 24px;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 32px;
		text-decoration: none;
	}
	.brand-wordmark:hover {
		color: var(--brand-dark);
	}
	.brand-wordmark__fp {
		color: var(--brand-accent);
	}
	/* Labels never break inside; when they don't fit, whole items wrap to the next line
	   (on phones the menu hides behind a hamburger). */
	.menu {
		display: flex;
		flex-wrap: wrap;
		gap: 0 24px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.menu a {
		display: inline-block;
		padding: 8px 0;
		color: var(--brand-graphite);
		font-size: 16px;
		font-weight: 500;
		line-height: 1.5;
		text-decoration: none;
		white-space: nowrap;
	}
	.menu a:hover {
		color: var(--brand-dark);
	}
	.menu a[aria-current='page'] {
		color: var(--brand-dark);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}
	.menu-toggle {
		display: none;
	}
	@media (max-width: 600px) {
		.brand-wordmark {
			font-size: 22px;
		}
		/* Phones: the newsletter stays in the footer only, to keep the menu short. */
		.hide-phone {
			display: none;
		}
		/* Phones: hamburger that opens a full-screen menu; the X closes it. */
		.menu-toggle {
			position: relative;
			z-index: 101;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 48px;
			height: 48px;
			margin-right: -12px;
			padding: 0;
			border: 0;
			border-radius: 8px;
			background: none;
			color: var(--brand-dark);
			cursor: pointer;
		}
		.menu-toggle .icon-close,
		nav.is-open .menu-toggle .icon-open {
			display: none;
		}
		nav.is-open .menu-toggle .icon-close {
			display: block;
		}
		nav.is-open .brand-wordmark {
			position: relative;
			z-index: 101;
		}
		.menu {
			display: none;
		}
		nav.is-open .menu {
			position: fixed;
			inset: 0;
			z-index: 100;
			display: flex;
			flex-direction: column;
			flex-wrap: nowrap;
			gap: 8px;
			padding: 96px 16px 48px;
			overflow-y: auto;
			background: var(--brand-light);
		}
		nav.is-open .menu a {
			display: block;
			padding: 12px 0;
			color: var(--brand-dark);
			font-size: 24px;
			font-weight: 600;
			letter-spacing: -0.015em;
			line-height: 1.2;
			white-space: normal;
		}
		nav.is-open .menu a[aria-current='page'] {
			color: var(--brand-accent);
		}
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('header nav');
	const toggle = nav?.querySelector<HTMLButtonElement>('.menu-toggle');
	if (nav && toggle) {
		const setOpen = (open: boolean) => {
			nav.classList.toggle('is-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
			document.documentElement.style.overflow = open ? 'hidden' : '';
		};
		toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && nav.classList.contains('is-open')) {
				setOpen(false);
				toggle.focus();
			}
		});
		nav.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
		// Back to desktop width with the menu open: unlock the page scroll.
		matchMedia('(min-width: 601px)').addEventListener('change', (e) => e.matches && setOpen(false));
	}
</script>
