---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="logo" href="/">{SITE_TITLE}</a>
	</nav>
</header>
<style>
	header {
		padding: 0 1rem;
		background: white;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		max-width: 1156px;
		margin: 0 auto;
		padding: 1rem 0;
	}
	.logo {
		color: var(--accent);
		font-size: 24px;
		font-weight: 800;
		letter-spacing: -0.5px;
		line-height: 30px;
		text-decoration: none;
	}
</style>
