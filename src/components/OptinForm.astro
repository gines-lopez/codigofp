---
// Landing opt-in form (.brand-optin), same markup and fields as the hero forms of the landings.
// Submitted to MailerLite by src/scripts/mailerlite-optin.ts, which the page must import.
// `id` must be unique on the page; the default slot is the reassurance note under the row and
// the optional `legal` slot is the smaller first data-protection layer under that note.
import { MAILERLITE_FORM_ACTION } from '../consts';

interface Props {
	id: string;
	class?: string;
	buttonText?: string;
	label?: string;
}

const {
	id,
	class: className,
	buttonText = 'Mándamelos',
	label = '¿A qué correo te lo mando?',
} = Astro.props;
// A slot passed conditionally still counts as present: render it and keep it only if not empty.
const legal = Astro.slots.has('legal') ? (await Astro.slots.render('legal')).trim() : '';
---

<form class:list={['brand-optin', className]} action={MAILERLITE_FORM_ACTION} method="post">
	<input type="hidden" name="ml-submit" value="1" />
	<input type="hidden" name="anticsrf" value="true" />
	<label for={id}>{label}</label>
	<div class="brand-optin-row">
		<input
			class="brand-input"
			id={id}
			name="fields[email]"
			type="email"
			placeholder="tucorreo@ejemplo.com"
			autocomplete="email"
			required
		/>
		<button class="brand-button" type="submit">{buttonText}</button>
	</div>
	{Astro.slots.has('default') && <p class="brand-optin-note"><slot /></p>}
	{legal && <p class="brand-optin-legal" set:html={legal} />}
</form>
