---
// A blog post, after ramp.com/blog: a tinted header band (breadcrumb, date and reading time, H1,
// author, and the cover or the lead on the right), then two columns: a sticky sidebar (share,
// «En este artículo», a newsletter card) and the article at a 720px measure. Under it: the
// newsletter box, an author note and three related posts.
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import PostCard from '../components/blog/PostCard.astro';
import Footer from '../components/Footer.astro';
import GuideOptin from '../components/guide/GuideOptin.astro';
import Header from '../components/Header.astro';
import { PROOF_2025, SITE_TITLE } from '../consts';
import { byDate, categoryOf, getPosts, readingTime } from '../lib/posts';

interface Props {
	post: CollectionEntry<'blog'>;
	headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, draft } = post.data;
const category = categoryOf(post);
const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const revised = updatedDate && updatedDate.getTime() !== pubDate.getTime() ? updatedDate : undefined;

const others = byDate(await getPosts()).filter((p) => p.id !== post.id);
const related = [
	...others.filter((p) => p.data.category === post.data.category),
	...others.filter((p) => p.data.category !== post.data.category),
].slice(0, 3);

const url = new URL(Astro.url.pathname, Astro.site).href;
const enc = encodeURIComponent;
const share = [
	{ label: 'X', href: `https://x.com/intent/post?url=${enc(url)}&text=${enc(title)}`, icon: 'x' },
	{ label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`, icon: 'linkedin' },
	{ label: 'WhatsApp', href: `https://wa.me/?text=${enc(`${title} ${url}`)}`, icon: 'whatsapp' },
	{ label: 'correo', href: `mailto:?subject=${enc(title)}&body=${enc(url)}`, icon: 'mail' },
];
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	inLanguage: 'es',
	mainEntityOfPage: url,
	articleSection: category.name,
	author: { '@type': 'Person', name: 'Ginés López', jobTitle: 'Docente de FP de Informática', url: new URL('/sobre-mi/', Astro.site).href },
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.href },
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} image={heroImage} noindex={draft} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<main>
			<header class="band">
				<div class="band-inner">
					<div class="band-text">
						<nav class="crumbs" aria-label="Migas de pan">
							<a href="/blog/">Blog</a>
							<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"
								><path d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg
							>
							<a href={`/blog/tema/${category.slug}/`}>{category.name}</a>
						</nav>
						{draft && <p class="draft">Borrador: solo se ve en local</p>}
						<p class="meta">
							Publicado el <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
							{revised && (
								<>
									{' · '}Revisado el <time datetime={revised.toISOString()}>{fmt(revised)}</time>
								</>
							)}
							{` · ${minutes} min de lectura`}
						</p>
						<h1>{title}</h1>
						<div class="author">
							<span class="monogram" aria-hidden="true">G</span>
							<p>
								<a href="/sobre-mi/">Ginés López</a>
								<span>Docente de FP de Informática y funcionario de carrera</span>
							</p>
						</div>
					</div>
					{
						heroImage ? (
							<Image class="cover" src={heroImage} width={1280} height={640} alt="" loading="eager" />
						) : (
							<p class="band-lead">{description}</p>
						)
					}
				</div>
			</header>

			<div class="layout">
				<aside class="side">
					<div class="side-sticky">
						<ul class="share" aria-label="Compartir el artículo">
							{
								share.map((s) => (
									<li>
										<a href={s.href} target="_blank" rel="noopener" aria-label={`Compartir por ${s.label} (se abre en otra pestaña)`}>
											{s.icon === 'x' && (
												<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
													<path d="M17.75 3h3.07l-6.72 7.68L22 21h-6.19l-4.84-6.33L5.4 21H2.33l7.19-8.21L2 3h6.35l4.38 5.78L17.75 3Zm-1.08 16.18h1.7L7.4 4.72H5.57l11.1 14.46Z" fill="currentColor"></path>
												</svg>
											)}
											{s.icon === 'linkedin' && (
												<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
													<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.83v1.54h.06c.53-1 1.84-2.06 3.8-2.06 4.05 0 4.81 2.67 4.81 6.14V21h-4v-4.98c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.92 1.3-1.92 2.63V21H9.5V9.75Z" fill="currentColor"></path>
												</svg>
											)}
											{s.icon === 'whatsapp' && (
												<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
													<path d="M12 2.5a9.5 9.5 0 0 0-8.2 14.3L2.5 21.5l4.8-1.26A9.5 9.5 0 1 0 12 2.5Zm0 17.2a7.7 7.7 0 0 1-3.93-1.08l-.28-.17-2.85.75.76-2.78-.18-.29A7.7 7.7 0 1 1 12 19.7Zm4.22-5.77c-.23-.12-1.37-.68-1.58-.75-.21-.08-.37-.12-.52.11-.15.23-.6.75-.73.9-.13.16-.27.17-.5.06a6.3 6.3 0 0 1-1.86-1.15 7 7 0 0 1-1.29-1.6c-.13-.23 0-.36.1-.47.11-.11.23-.27.35-.4.11-.14.15-.24.23-.39.08-.16.04-.3-.02-.41-.06-.12-.52-1.26-.72-1.72-.19-.45-.38-.39-.52-.4h-.45c-.15 0-.4.06-.61.29-.21.23-.8.78-.8 1.9s.82 2.2.93 2.35c.12.16 1.61 2.46 3.9 3.45.55.23.97.37 1.3.48.55.17 1.05.15 1.44.09.44-.07 1.37-.56 1.56-1.1.2-.54.2-1 .13-1.1-.05-.1-.2-.15-.44-.27Z" fill="currentColor"></path>
												</svg>
											)}
											{s.icon === 'mail' && (
												<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
													<path d="M3.75 5.75h16.5v12.5H3.75zM4 6l8 7 8-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
												</svg>
											)}
										</a>
									</li>
								))
							}
							<li>
								<button type="button" class="copy" data-url={url} aria-label="Copiar el enlace del artículo">
									<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
										<path d="M10 14a4.5 4.5 0 0 0 6.36 0l3-3a4.5 4.5 0 0 0-6.36-6.36l-1 1M14 10a4.5 4.5 0 0 0-6.36 0l-3 3a4.5 4.5 0 0 0 6.36 6.36l1-1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
									</svg>
								</button>
								<span class="copied" role="status"></span>
							</li>
						</ul>

						{
							toc.length >= 2 && (
								<nav class="toc" aria-label="En este artículo">
									<p class="toc-title">En este artículo</p>
									<ol>
										{toc.map((h) => (
											<li>
												<a href={`#${h.slug}`} data-toc={h.slug}>
													{h.text}
												</a>
											</li>
										))}
									</ol>
								</nav>
							)
						}

						<div class="side-card">
							<p class="side-card-title">Una decisión de la programación, cada martes</p>
							<p>Y al confirmar, el vídeo, el autodiagnóstico y el mapa del orden.</p>
							<a class="brand-button" href="#suscripcion">Suscribirme</a>
						</div>
					</div>
				</aside>

				<article class="article">
					{
						toc.length >= 2 && (
							<details class="toc-inline">
								<summary>En este artículo</summary>
								<ol>
									{toc.map((h) => (
										<li>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ol>
							</details>
						)
					}
					<div class="prose">
						<slot />
					</div>

					<div class="end-box" id="suscripcion">
						<GuideOptin id="optin-post" title="Una decisión de la programación, cada martes" full>
							<p>
								Si te ha servido, cada martes te llega otra decisión de la programación didáctica y cómo sostenerla ante el
								tribunal. Nunca trata del tema escrito ni del supuesto práctico.
							</p>
						</GuideOptin>
					</div>

					<p class="editorial">
						Soy <a href="/sobre-mi/">Ginés López</a>, docente de FP de Informática y funcionario de carrera.
						{` En 2025 saqué un ${PROOF_2025.score} ${PROOF_2025.what}, ${PROOF_2025.best}.`}
					</p>
				</article>
			</div>

			{
				related.length > 0 && (
					<section class="related" aria-labelledby="related-title">
						<h2 id="related-title">Sigue leyendo</h2>
						<div class="related-grid">
							{related.map((p) => (
								<PostCard post={p} />
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer showAbout />
		<script>
			import '../scripts/mailerlite-optin';

			// Highlight the section being read in the sidebar index.
			const links = new Map(
				[...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc, a]),
			);
			if (links.size) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							links.forEach((a) => a.removeAttribute('aria-current'));
							links.get(entry.target.id)?.setAttribute('aria-current', 'location');
						}
					},
					{ rootMargin: '0px 0px -75% 0px' },
				);
				document.querySelectorAll('.prose h2[id]').forEach((h) => observer.observe(h));
			}

			// Copy link: the status text is announced and fades after two seconds.
			const copy = document.querySelector<HTMLButtonElement>('.copy');
			const status = document.querySelector<HTMLElement>('.copied');
			copy?.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(copy.dataset.url ?? location.href);
					if (status) status.textContent = 'Enlace copiado';
				} catch {
					if (status) status.textContent = 'No se ha podido copiar';
				}
				setTimeout(() => status && (status.textContent = ''), 2000);
			});
		</script>
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	::selection {
		background: var(--brand-accent);
		color: var(--brand-light);
	}
	main {
		flex: 1;
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0 0 96px;
	}

	/* Header band: niebla surface across the page, text left and cover (or lead) right. */
	.band {
		background: var(--brand-line);
	}
	.band-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 48px 64px;
		align-items: end;
		width: 1188px;
		max-width: 100%;
		box-sizing: border-box;
		margin: 0 auto;
		padding: 48px 16px 64px;
	}
	.crumbs {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 32px;
		font-size: 15px;
		line-height: 1.5;
	}
	.crumbs a {
		color: var(--brand-dark);
		text-decoration: none;
	}
	.crumbs a:hover {
		text-decoration: underline;
	}
	.crumbs svg {
		color: var(--brand-graphite);
	}
	.meta {
		margin: 0 0 16px;
		color: var(--brand-graphite);
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.5;
	}
	.draft {
		display: inline-block;
		margin: 0 0 12px;
		padding: 2px 8px;
		color: var(--brand-graphite);
		font-family: var(--font-mono);
		font-size: 13px;
		border: 1px solid var(--brand-line-strong);
		border-radius: 4px;
	}
	h1 {
		margin: 0 0 32px;
	}
	.author {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.monogram {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		flex: none;
		border-radius: 8px;
		background: var(--brand-dark);
		color: var(--brand-light);
		font-size: 18px;
		font-weight: 700;
	}
	.author p {
		display: flex;
		flex-direction: column;
		margin: 0;
		font-size: 15px;
		line-height: 1.4;
	}
	.author a {
		color: var(--brand-dark);
		font-weight: 600;
		text-decoration: none;
	}
	.author a:hover {
		text-decoration: underline;
	}
	.author p span {
		color: var(--brand-graphite);
	}
	.band :global(.cover) {
		width: 100%;
		height: auto;
		border-radius: 8px;
	}
	.band-lead {
		margin: 0;
		color: var(--brand-graphite);
		font-size: 26px;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}

	/* Two columns: sticky sidebar and the article. */
	.layout {
		display: grid;
		grid-template-columns: 280px minmax(0, 720px);
		justify-content: space-between;
		gap: 64px;
		width: 1188px;
		max-width: 100%;
		box-sizing: border-box;
		margin: 0 auto;
		padding: 64px 16px 0;
	}
	.side-sticky {
		position: sticky;
		top: 24px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}
	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.share a,
	.copy {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 0;
		border-radius: 8px;
		background: none;
		color: var(--brand-graphite);
		cursor: pointer;
	}
	.share a:hover,
	.copy:hover {
		background: var(--brand-line);
		color: var(--brand-dark);
	}
	.copy:focus-visible {
		outline: 2px solid var(--brand-accent);
		outline-offset: 2px;
	}
	.share li:last-child {
		position: relative;
	}
	.copied {
		position: absolute;
		left: 48px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--brand-graphite);
		font-size: 13px;
		white-space: nowrap;
	}
	.toc-title {
		margin: 0 0 12px;
		font-size: 15px;
		font-weight: 600;
	}
	.toc ol {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 15px;
		line-height: 1.45;
	}
	.toc li + li {
		margin-top: 4px;
	}
	.toc a {
		display: block;
		padding: 4px 0 4px 12px;
		border-left: 1px solid var(--brand-line);
		color: var(--brand-graphite);
		text-decoration: none;
	}
	.toc a:hover {
		color: var(--brand-dark);
	}
	.toc a[aria-current] {
		padding-left: 11px;
		border-left: 2px solid var(--brand-accent);
		color: var(--brand-dark);
		font-weight: 500;
	}
	.side-card {
		padding: 24px;
		border-radius: 8px;
		background: var(--brand-line);
	}
	.side-card-title {
		margin: 0 0 8px;
		font-size: 17px;
		font-weight: 600;
		line-height: 1.35;
	}
	.side-card p {
		margin: 0 0 16px;
		font-size: 15px;
		line-height: 1.5;
	}
	.side-card .brand-button {
		justify-content: center;
		width: 100%;
	}

	/* The article. */
	.article {
		min-width: 0;
	}
	.toc-inline {
		display: none;
	}
	.prose > :global(*:first-child) {
		margin-top: 0;
	}
	.prose :global(h2) {
		margin: 64px 0 16px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--brand-line);
		scroll-margin-top: 24px;
	}
	.prose :global(h3) {
		margin: 40px 0 8px;
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}
	.prose > :global(p) {
		margin: 0 0 20px;
		font-size: 17px;
		line-height: 1.7;
	}
	.prose > :global(ul),
	.prose > :global(ol) {
		margin: 0 0 20px;
		padding-left: 24px;
		font-size: 17px;
		line-height: 1.7;
	}
	.prose > :global(ul) > :global(li),
	.prose > :global(ol) > :global(li) {
		margin-bottom: 8px;
	}
	.prose :global(strong) {
		font-weight: 600;
	}
	.prose > :global(img),
	.prose > :global(p > img) {
		display: block;
		margin: 32px 0;
		border-radius: 8px;
	}
	.prose > :global(blockquote) {
		margin: 32px 0;
		padding-left: 24px;
		border-left: 1px solid var(--brand-line-strong);
		font-size: 22px;
		line-height: 1.45;
	}
	.prose :global(pre) {
		margin: 24px 0;
		padding: 16px 20px;
		border: 1px solid var(--brand-line);
		border-radius: 8px;
		background: var(--brand-light) !important;
		font-size: 14px;
		line-height: 1.6;
		overflow-x: auto;
	}
	.prose :global(table) {
		margin: 24px 0;
		border-collapse: collapse;
		font-size: 16px;
	}
	.prose :global(th),
	.prose :global(td) {
		padding: 8px 12px 8px 0;
		border-bottom: 1px solid var(--brand-line);
		text-align: left;
	}
	.prose :global(mark) {
		padding: 0 2px;
		border-radius: 2px;
		background: var(--brand-line);
		color: var(--brand-dark);
	}

	/* End: newsletter box (hueso, framed like every form), a rule, the editorial note. */
	.end-box {
		margin-top: 64px;
		scroll-margin-top: 24px;
	}
	.end-box :global(.optin) {
		margin: 0;
	}
	.editorial {
		margin: 40px 0 0;
		padding-top: 24px;
		border-top: 1px solid var(--brand-line-strong);
		color: var(--brand-graphite);
		font-size: 14px;
		line-height: 1.6;
	}

	.related {
		width: 1188px;
		max-width: 100%;
		box-sizing: border-box;
		margin: 96px auto 0;
		padding: 0 16px;
	}
	.related h2 {
		margin: 0 0 24px;
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	/* Tablet and phone: one column; the sidebar keeps only the share row, the index folds in. */
	@media (max-width: 1080px) {
		.band-inner,
		.layout {
			grid-template-columns: minmax(0, 1fr);
		}
		.band-inner {
			gap: 32px;
		}
		.layout {
			width: 752px;
			gap: 24px;
			padding-top: 32px;
		}
		.side-sticky {
			position: static;
		}
		.toc,
		.side-card {
			display: none;
		}
		.toc-inline {
			display: block;
			margin-bottom: 40px;
			padding: 16px 20px;
			border: 1px solid var(--brand-line);
			border-radius: 8px;
		}
		.toc-inline summary {
			cursor: pointer;
			font-weight: 600;
		}
		.toc-inline ol {
			margin: 12px 0 0;
			padding-left: 20px;
			font-size: 15px;
			line-height: 1.5;
		}
		.toc-inline li + li {
			margin-top: 8px;
		}
		.related-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 600px) {
		.band-inner {
			padding: 32px 16px 40px;
