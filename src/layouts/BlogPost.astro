---
// A blog post: the shared Article layout with «Blog → Tema» breadcrumb and three related posts
// (same topic first).
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { byDate, categoryOf, getPosts, readingTime } from '../lib/posts';
import Article from './Article.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const category = categoryOf(post);
const others = byDate(await getPosts()).filter((p) => p.id !== post.id);
const related = [
	...others.filter((p) => p.data.category === post.data.category),
	...others.filter((p) => p.data.category !== post.data.category),
].slice(0, 3);
---

<Article
	kind="artículo"
	{...post.data}
	headings={headings}
	minutes={readingTime(post.body)}
	section={category.name}
	related={related}
	crumbs={[
		{ label: 'Blog', href: '/blog/' },
		{ label: category.name, href: `/blog/tema/${category.slug}/` },
	]}
>
	<slot />
</Article>
