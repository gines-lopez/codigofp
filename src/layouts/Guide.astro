---
// Reading template for the pillar guides and the blog posts (Read mode): breadcrumb, H1, lead,
// byline with dates and reading time, table of contents (inline on phones, sticky aside from
// 1200px, only with 3+ sections) and the article at a 720px measure. The `after` slot (newsletter,
// related posts) goes under the article.
import type { ImageMetadata, MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	headings: MarkdownHeading[];
	kind?: 'guía' | 'artículo';
	breadcrumb?: { label: string; href: string }[];
	lead?: string;
	readingTime?: number;
	heroImage?: ImageMetadata;
	draft?: boolean;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	headings,
	kind = 'guía',
	breadcrumb = [],
	lead,
	readingTime,
	heroImage,
	draft,
} = Astro.props;
const guide = kind === 'guía';
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
const tocLabel = guide ? 'En esta guía' : 'En este artículo';
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const revised = updatedDate && updatedDate.getTime() !== pubDate.getTime() ? updatedDate : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': guide ? 'Article' : 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	inLanguage: 'es',
	mainEntityOfPage: canonical,
	author: { '@type': 'Person', name: 'Ginés López', jobTitle: 'Docente de FP de Informática', url: new URL('/sobre-mi/', Astro.site).href },
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.href },
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description} noindex={draft} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<main class:list={['guide', { 'no-toc': !showToc }]}>
			{
				showToc && (
					<aside class="toc-side" aria-label={tocLabel}>
						<p class="toc-title">{tocLabel}</p>
						<ol>
							{toc.map((h) => (
								<li>
									<a href={`#${h.slug}`} data-toc={h.slug}>
										{h.text}
									</a>
								</li>
							))}
						</ol>
					</aside>
				)
			}

			<article class="guide-article">
				<header class="guide-head">
					{
						breadcrumb.length > 0 && (
							<nav class="crumbs" aria-label="Migas de pan">
								<ol>
									{breadcrumb.map((c) => (
										<li>
											<a href={c.href}>{c.label}</a>
										</li>
									))}
								</ol>
							</nav>
						)
					}
					{draft && <p class="draft">Borrador: solo se ve en local</p>}
					<h1>{title}</h1>
					{lead && <p class="brand-lead lead">{lead}</p>}
					<p class="byline">
						<a href="/sobre-mi/">Ginés López</a>, docente de FP de Informática y funcionario de carrera
						<span class="dates">
							{guide ? 'Publicada' : 'Publicado'} el <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
							{revised && (
								<>
									· {guide ? 'Revisada' : 'Revisado'} el <time datetime={revised.toISOString()}>{fmt(revised)}</time>
								</>
							)}
							{readingTime && <> · {readingTime} min de lectura</>}
						</span>
					</p>
				</header>

				{heroImage && <Image class="hero" src={heroImage} width={1440} height={720} alt="" />}

				{
					showToc && (
						<details class="toc-inline">
							<summary>Índice</summary>
							<ol>
								{toc.map((h) => (
									<li>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ol>
						</details>
					)
				}

				<div class="prose">
					<slot />
				</div>
				<slot name="after" />
			</article>
		</main>
		<Footer showAbout />
		<script>
			import '../scripts/mailerlite-optin';

			// Highlight the section being read in the side index.
			const links = new Map(
				[...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc, a]),
			);
			if (links.size) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							links.forEach((a) => a.removeAttribute('aria-current'));
							links.get(entry.target.id)?.setAttribute('aria-current', 'location');
						}
					},
					{ rootMargin: '0px 0px -75% 0px' },
				);
				document.querySelectorAll('.prose h2[id]').forEach((h) => observer.observe(h));
			}
		</script>
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	::selection {
		background: var(--brand-accent);
		color: var(--brand-light);
	}
	.guide {
		flex: 1;
		width: 752px;
		max-width: 100%;
		box-sizing: border-box;
		padding: 48px 16px 96px;
	}
	.guide-article {
		min-width: 0;
	}

	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		margin: 0 0 24px;
		padding: 0;
		list-style: none;
		font-size: 15px;
		line-height: 1.5;
	}
	.crumbs li + li::before {
		content: '/';
		margin: 0 8px;
		color: var(--brand-line-strong);
	}
	.crumbs a {
		color: var(--brand-graphite);
		text-decoration: none;
	}
	.crumbs a:hover {
		color: var(--brand-dark);
		text-decoration: underline;
	}
	.draft {
		display: inline-block;
		margin: 0 0 16px;
		padding: 4px 8px;
		border: 1px solid var(--brand-line-strong);
		border-radius: 8px;
		color: var(--brand-graphite);
		font-family: var(--font-mono);
		font-size: 13px;
	}
	.guide-head h1 {
		margin: 0 0 24px;
	}
	.lead {
		margin: 0 0 24px;
		color: var(--brand-graphite);
	}
	.byline {
		margin: 0;
		color: var(--brand-graphite);
		font-size: 15px;
		line-height: 1.5;
	}
	.byline a {
		color: var(--brand-dark);
		font-weight: 600;
	}
	.dates {
		display: block;
		margin-top: 4px;
		font-family: var(--font-mono);
		font-size: 13px;
	}
	.guide-article :global(.hero) {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 32px;
		border-radius: 8px;
	}

	/* Index: inline and folded on phones and tablets. */
	.toc-inline {
		margin: 32px 0 0;
		padding: 16px 24px;
		border: 1px solid var(--brand-line);
		border-radius: 8px;
	}
	.toc-inline summary {
		cursor: pointer;
		font-weight: 600;
	}
	.toc-inline ol,
	.toc-side ol {
		margin: 16px 0 0;
		padding-left: 20px;
		font-size: 15px;
		line-height: 1.5;
	}
	.toc-inline li + li,
	.toc-side li + li {
		margin-top: 8px;
	}
	.toc-side {
		display: none;
	}

	/* Prose: the measure and rhythm of the article. */
	.prose {
		margin-top: 40px;
	}
	.prose :global(h2) {
		margin: 72px 0 16px;
		scroll-margin-top: 24px;
	}
	.prose > :global(h2:first-child) {
		margin-top: 0;
	}
	.prose :global(h3) {
		margin: 40px 0 8px;
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}
	.prose > :global(p) {
		margin: 0 0 16px;
	}
	.prose > :global(ul),
	.prose > :global(ol) {
		margin: 0 0 16px;
		padding-left: 24px;
	}
	.prose > :global(ul) > :global(li),
	.prose > :global(ol) > :global(li) {
		margin-bottom: 8px;
	}
	.prose :global(strong) {
		font-weight: 600;
	}
	.prose > :global(img) {
		display: block;
		margin: 32px 0;
	}
	.prose :global(pre) {
		margin: 24px 0;
		padding: 16px 20px;
		border: 1px solid var(--brand-line);
		border-radius: 8px;
		background: var(--brand-light) !important;
		font-size: 14px;
		line-height: 1.6;
		overflow-x: auto;
	}
	.prose :global(mark) {
		padding: 0 2px;
		border-radius: 2px;
		background: var(--brand-line);
		color: var(--brand-dark);
	}
	.prose :global(.closing) {
		margin: 40px 0;
		font-size: 26px;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}

	/* From 1200px: sticky index on the left, article at 720px. */
	@media (min-width: 1200px) {
		.guide:not(.no-toc) {
			display: grid;
			grid-template-columns: 240px 720px;
			gap: 64px;
			width: 1056px;
		}
		.toc-side {
			display: block;
			position: sticky;
			top: 24px;
			align-self: start;
			max-height: calc(100vh - 48px);
			overflow-y: auto;
			padding-top: 8px;
		}
		.toc-title {
			margin: 0;
			color: var(--brand-graphite);
			font-family: var(--font-mono);
			font-size: 13px;
		}
		.toc-side ol {
			padding-left: 0;
			list-style: none;
			font-size: 14px;
		}
		.toc-side a {
			display: block;
			padding-left: 12px;
			border-left: 1px solid var(--brand-line);
			color: var(--brand-graphite);
			text-decoration: none;
		}
		.toc-side a:hover {
			color: var(--brand-dark);
		}
		.toc-side a[aria-current] {
			border-left: 2px solid var(--brand-accent);
			padding-left: 11px;
			color: var(--brand-dark);
			font-weight: 500;
		}
		.toc-inline {
			display: none;
		}
	}
	@media (max-width: 600px) {
		.guide {
			padding: 32px 16px 64px;
		}
		.prose :global(h2) {
			margin-top: 56px;
		}
		.toc-inline {
			padding: 16px;
		}
		.prose :global(.closing) {
			font-size: 20px;
		}
	}
</style>
