---
import { Font } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { NEWSLETTER_TOPICS } from '../consts';
import OptinForm from '../components/OptinForm.astro';
import TrackRecord from '../components/TrackRecord.astro';
import '../styles/landing-meta-libreta.css';

const title = 'CódigoFP · En qué orden se monta una programación que aguanta el «por qué»';
const description =
	'En 6 minutos verás en qué orden se monta una programación de FP que aguanta cada «por qué» del tribunal. Luego pasas la tuya por el autodiagnóstico en 20 minutos.';


const deliverables = [
	{
		tag: 'Vídeo · 6 min',
		title: 'El orden, parte por parte',
		text: 'Empieza en la sala, con la pregunta que me hicieron en mi defensa. Sin presentaciones.',
		body: [
			'Sabes qué has puesto. Lo que cuesta es explicar por qué está ahí y no en otro sitio.',
			'En el vídeo te enseño el orden que hace que cada decisión tenga respuesta.',
		],
	},
	{
		tag: 'PDF · 20 min',
		title: 'El autodiagnóstico: ¿tu programación aguanta el por qué?',
		text: 'Cada ítem es una pregunta del tribunal. Tres casillas, y la del medio es la que duele.',
		checks: [
			{ label: 'Lo tengo y sé por qué lo decidí' },
			{ label: 'Lo tengo, pero respondería con la normativa', marked: true },
			{ label: 'No lo tengo resuelto' },
		],
	},
	{
		tag: 'PDF · 1 página',
		title: 'El mapa del orden',
		text: 'Una página: cada parte, su decisión y la pregunta que aguanta.',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title} description={description} noindex />
		<Font cssVariable="--font-kalam" />
	</head>
	<body>
		<Header linkLogo={false} />
		<main class="libreta">
			<div class="margen">
				<span class="nota" aria-hidden="true">¿y tu<br />respuesta?</span>
			</div>

			<div class="hoja">
				<section class="pitch">
					<h1>
						Opositor de FP: en 6&nbsp;minutos verás en qué orden se monta una programación que aguanta
						cada <span class="circled"
							>«por qué»<svg
								class="ring"
								aria-hidden="true"
								viewBox="0 0 240 90"
								preserveAspectRatio="none"
								><path
									pathLength="100"
									d="M196 14 C150 2 52 4 20 26 C-4 44 14 74 70 82 C132 90 214 82 232 56 C246 34 216 12 168 8 C140 6 118 9 104 13"
								></path></svg
							></span
						> del tribunal.
					</h1>
					<p class="brand-lead">
						Parte por parte: qué decides, por qué va ahí y qué te van a preguntar. Luego pasas la tuya por
						el autodiagnóstico en 20 minutos.
					</p>

					<OptinForm id="email-l" label="¿A qué correo te mando el vídeo y el autodiagnóstico?">
						Confirmas tu email y te llega en un par de minutos. Luego, un correo cada martes sobre
						{NEWSLETTER_TOPICS}. Sin spam, y te das de baja con un clic.
						<Fragment slot="legal">
							Responsable: CódigoFP. Tus datos solo sirven para enviarte esto y se guardan en MailerLite.
							<a href="/politica-privacidad/">Política de privacidad</a>.
						</Fragment>
					</OptinForm>
				</section>

				<TrackRecord compact columns showSince sinceDetail class="libreta-record" />

				<section class="deliverables">
					<h2>Lo que te llega al correo</h2>
					<ul class="deliverable-list">
						{
							deliverables.map((item) => (
								<li class="deliverable">
									<p class="deliverable-tag">{item.tag}</p>
									<div class="deliverable-body">
										<h3 class="deliverable-title">{item.title}</h3>
										<p class="deliverable-text">{item.text}</p>
										{item.body?.map((paragraph) => <p class="deliverable-text">{paragraph}</p>)}
										{item.checks && (
											<p class="brand-label">así se ve cada pregunta del autodiagnóstico</p>
										)}
										{item.checks && (
											<ul class="checks">
												{item.checks.map((check) => (
													<li class:list={{ marked: check.marked }}>
														<span class="box" aria-hidden="true">
															{check.marked && (
																<svg viewBox="0 0 24 24">
																	<path d="M3 4 C9 10 14 15 21 22 M20 3 C14 9 9 15 4 21" />
																</svg>
															)}
														</span>
														{check.label}
														{check.marked && <span class="sr-only"> (marcada)</span>}
													</li>
												))}
											</ul>
										)}
									</div>
								</li>
							))
						}
					</ul>
					<p class="closing">
						No es una plantilla ni una programación para copiar. La que vas a defender es la tuya, y
						tiene que sonar a ti.
					</p>
					<p class="end-cta"><a class="brand-button" href="#email-l" data-scroll-to-form>Quiero los tres <span aria-hidden="true">↑</span></a></p>
				</section>
			</div>
		</main>
		<Footer landing />
		<script>
			import '../scripts/mailerlite-optin';
			import '../scripts/scroll-to-form';
		</script>
	</body>
</html>
