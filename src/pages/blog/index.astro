---
import BaseHead from '../../components/BaseHead.astro';
import BlogListing from '../../components/blog/BlogListing.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { NEWSLETTER_TOPICS, SITE_TITLE } from '../../consts';
import { byDate, getPosts } from '../../lib/posts';

const posts = byDate(await getPosts());
const lead = `Artículos sobre ${NEWSLETTER_TOPICS}, escritos por alguien que acaba de pasar por ella.`;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Blog · ${SITE_TITLE}`} description={lead} />
	</head>
	<body>
		<Header />
		<BlogListing title="Blog" lead={lead} posts={posts} allPosts={posts} />
		<Footer showAbout />
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
</style>
