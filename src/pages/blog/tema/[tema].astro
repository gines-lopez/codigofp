---
// One page per blog topic: /blog/tema/<slug>/ (BLOG_CATEGORIES in src/consts.ts). Later pages live
// in /blog/tema/<slug>/pagina/<n>/.
import BaseHead from '../../../components/BaseHead.astro';
import BlogListing from '../../../components/blog/BlogListing.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { BLOG_CATEGORIES, SITE_TITLE } from '../../../consts';
import { byDate, getPosts, paginate } from '../../../lib/posts';

export function getStaticPaths() {
	return BLOG_CATEGORIES.map((c) => ({ params: { tema: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const all = byDate(await getPosts());
const pages = paginate(all.filter((p) => p.data.category === category.slug));
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${category.name} · Blog · ${SITE_TITLE}`} description={category.text} />
	</head>
	<body>
		<Header />
		<BlogListing
			title={category.name}
			lead={category.text}
			posts={pages[0]}
			allPosts={all}
			active={category.slug}
			base={`/blog/tema/${category.slug}/`}
			page={1}
			totalPages={pages.length}
		/>
		<Footer />
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
</style>
