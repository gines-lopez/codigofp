---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SubscribeFormMailerLite from '../components/SubscribeFormMailerLite.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { NEWSLETTER_SCOPE, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Página no encontrada | ${SITE_TITLE}`}
			description="Esta página no entraba en el temario."
			noindex
		/>
	</head>
	<body>
		<Header />
		<main class="not-found">
			<section class="hero">
				<p class="brand-label">error 404</p>
				<h1>Esta página no entraba en el temario</h1>
				<p class="lead">
					Es como sacar del bombo el tema que no habías estudiado. Por suerte, esto no puntúa: la
					página no existe. Puedes <a href="/">volver al inicio</a>.
				</p>
				<p class="lead lead-offer">Lo que sí puntúa es tu programación didáctica. {NEWSLETTER_SCOPE}</p>
				<SubscribeFormMailerLite />
				<p class="brand-optin-note form-note">
					Te das de baja con un clic. <a href="/politica-privacidad/">Política de privacidad</a>.
				</p>
				<LeadMagnet class="form-magnet" />
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	.not-found {
		flex: 1;
		width: 752px;
		max-width: 100%;
		box-sizing: border-box;
		padding: 48px 16px 96px;
	}
	.hero .brand-label {
		margin-bottom: 24px;
	}
	h1 {
		margin: 0 0 24px;
	}
	.lead {
		margin: 0 0 16px;
		color: var(--brand-graphite);
	}
	.form-note {
		margin-top: 16px;
	}
	.hero :global(.form-magnet) {
		margin-top: 32px;
	}
	.lead-offer {
		margin-bottom: 32px;
	}
	@media (max-width: 600px) {
		.not-found {
			padding: 32px 16px 64px;
		}
	}
</style>
