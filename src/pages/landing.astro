---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import OptinForm from '../components/OptinForm.astro';
import TrackRecord from '../components/TrackRecord.astro';
import '../styles/landing.css';

const title = 'CódigoFP · Una programación de FP que puedes defender';
const description =
	'Me quedé a 0,13 de la plaza con una programación que cumplía con todo. Dos años después saqué un 9,6 en la defensa, la mejor nota de mi especialidad, cambiando el orden en que la hice.';


// Each point: a short head (8 words at most) and the detail under it.
const points = [
	{
		title: 'Por qué se cae una programación que cumple.',
		text: 'El error no está en cómo redactas. Está en cuándo empiezas a redactar.',
	},
	{
		title: 'La pregunta que me hizo el tribunal en 2025.',
		text: 'Sobre unidades de programación y unidades de trabajo. En 2023 la habría contestado con un artículo. Esta vez no, y te cuento qué dije en su lugar.',
	},
	{
		title: 'Por qué la introducción se escribe al final.',
		text: 'Y la justificación, aunque las dos ocupen las primeras páginas. Con el orden completo de las decisiones, fase a fase, y la pregunta del tribunal que tiene que aguantar cada una.',
	},
	{
		title: 'El autodiagnóstico y el mapa del orden.',
		text: 'El autodiagnóstico son 20 minutos con tu programación delante y tiene una casilla incómoda: «lo tengo, pero respondería con la normativa». Si marcas muchas, ya sabes por dónde empezar. El mapa es una página para imprimir.',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title} description={description} noindex />
	</head>
	<body>
		<Header />
		<main class="landing">
			<p class="brand-label">para opositores de FP</p>
			<h1>Me quedé a 0,13 de la plaza con una programación que cumplía con todo.</h1>

			<div class="story">
				<p>
					Tenía los resultados de aprendizaje, los criterios, las unidades, la atención a la
					diversidad. Todo lo que pide la normativa.
				</p>
				<p>
					Lo que no tenía era una respuesta mía cuando me preguntaban por qué. Contestaba con el
					artículo.
				</p>
				<p>
					La noche que supe lo de las 13 centésimas monté cinco hojas de Excel. Recalculé méritos y
					plazas buscando un hueco que no había. Al día siguiente entendí que el problema no estaba en el Excel.
				</p>
			</div>

			<TrackRecord showPast={false} />

			<section class="early-cta" aria-label="Pedir el material">
				<p class="cta-text">
					Gratis, en cuanto confirmes tu email: «El orden, parte por parte» (vídeo de 6 minutos), el
					autodiagnóstico y el mapa del orden.
				</p>
				<OptinForm id="email-r-early">
					Te das de baja con un clic. <a href="/politica-privacidad/">Política de privacidad</a>.
				</OptinForm>
			</section>

			<div class="story">
				<p>
					¿Tienes la programación hecha? Cumple, y aun así hay apartados que no sabrías explicar. 
					Estás donde yo estaba en 2023.
				</p>
				<p>
					Si buscas una programación tipo para rellenar, hay academias que te la dan. Y una
					IA te escribe 60 páginas en una tarde.
				</p>
				<p>
					Pero saber qué contestar cuando el tribunal te pregunte por qué no te lo da ninguna de las dos.
				</p>
			</div>

			<section class="points">
				<h2>Lo que te mando para que tu programación aguante el por qué</h2>
				<ol>
					{
						points.map((point, i) => (
							<li>
								<span class="point-number">{String(i + 1).padStart(2, '0')}</span>
								<span>
									<strong class="point-title">{point.title}</strong>
									<span class="point-text">{point.text}</span>
								</span>
							</li>
						))
					}
				</ol>
			</section>

			<section class="cta">
				<p class="cta-text">
					Te lo mando en cuanto confirmes tu email: «El orden, parte por parte» (vídeo de 6 minutos), el autodiagnóstico y el mapa del orden.
				</p>
				<p class="end-cta"><a class="brand-button" href="#email-r-early" data-scroll-to-form>Quiero los tres <span aria-hidden="true">↑</span></a></p>
			</section>
		</main>
		<Footer />
		<script>
			import '../scripts/mailerlite-optin';
			import '../scripts/scroll-to-form';
		</script>
	</body>
</html>
