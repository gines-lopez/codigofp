---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { NEWSLETTER_EXCLUSION, NEWSLETTER_SCOPE } from '../consts';
import '../styles/gracias.css';

// Landing page after subscribing. MailerLite has double opt-in, so the only goal is getting the visitor
// to confirm in their inbox. Reached only through MailerLite's redirect: never link to it.
const title = 'Suscripción recibida · CódigoFP';
const description = 'Confirma tu email para recibir la newsletter de CódigoFP.';

const steps = [
	{
		title: 'Confirmas tu email.',
		text: 'El correo llega desde «Ginés de CódigoFP». Un clic en el botón y listo.',
	},
	{
		title: 'Recibes el vídeo y los dos PDF.',
		text: 'En cuanto confirmas, te llega el correo de bienvenida con «El orden, parte por parte», el autodiagnóstico y el mapa del orden.',
	},
	{
		title: 'Me respondes.',
		text: 'Ese correo termina con una pregunta. Contéstala: leo todas las respuestas yo.',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title} description={description} noindex />
	</head>
	<body>
		<Header />
		<main class="gracias">
			<section class="intro">
				<p class="brand-label">newsletter de CódigoFP</p>
				<h1>Estás a un correo de entrar</h1>
				<p class="brand-lead">
					Te acabo de enviar un email para confirmar tu dirección. Hasta que no lo confirmes, no te
					llega nada, tampoco el vídeo.
				</p>
				<p class="sender">Busca un correo de <strong>Ginés de CódigoFP</strong>.</p>
				<div class="mail-buttons">
					<a
						class="brand-button"
						href="https://mail.google.com"
						target="_blank"
						rel="noopener">Abrir Gmail<span class="sr-only"> (se abre en otra pestaña)</span></a
					>
					<a
						class="brand-button brand-button--secondary"
						href="https://outlook.office.com/mail/"
						target="_blank"
						rel="noopener">Abrir Outlook<span class="sr-only"> (se abre en otra pestaña)</span></a
					>
				</div>
			</section>

			<section class="block">
				<h2>Qué pasa ahora</h2>
				<ol class="steps">
					{
						steps.map((step, i) => (
							<li>
								<span class="step-number">{String(i + 1).padStart(2, '0')}</span>
								<p>
									<strong>{step.title}</strong> {step.text}
								</p>
							</li>
						))
					}
				</ol>
			</section>
			<section class="block">
				<h2>Si no lo ves en cinco minutos</h2>
				<p>
					Mira en spam y, si usas Gmail, en la pestaña Promociones. Si está ahí, muévelo a
					Principal: así los martes no se pierden.
				</p>
				<p>
					Si sigue sin aparecer, probablemente hay una errata en el email. Puedes <a href="/" data-back-to-form
						>volver a suscribirte con la dirección correcta</a
					>.
				</p>
			</section>

			<section class="personal">
				<h2>Lo que llega después</h2>
				<p>{NEWSLETTER_SCOPE} {NEWSLETTER_EXCLUSION}</p>
				<p class="signature">
					<strong>Ginés</strong><br />
					CódigoFP — Una programación didáctica que entiendes tú primero.
				</p>
			</section>
		</main>
		<Footer />
		<script>
			// Send a mistyped address back to the form the visitor came from (a landing or the home),
			// not always to the home. Falls back to / when the referrer is missing or external.
			const link = document.querySelector<HTMLAnchorElement>('[data-back-to-form]');
			try {
				const from = new URL(document.referrer);
				if (link && from.origin === location.origin && from.pathname !== location.pathname) {
					link.href = from.pathname;
				}
			} catch {
				// No referrer: keep the link to the home.
			}
		</script>
	</body>
</html>
