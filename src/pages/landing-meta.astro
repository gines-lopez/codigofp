---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TrackRecord from '../components/TrackRecord.astro';
import '../styles/landing-meta.css';

const title = 'CódigoFP · El orden de una programación defendible';
const description =
	'El orden en que se construye una programación de FP que aguanta cada «por qué» del tribunal.';

// Kit form that receives the subscriptions (same one as the home for now).
const KIT_FORM_ID = '9943840';

const deliverables = [
	{
		tag: 'Vídeo · 6 min',
		title: 'El orden, parte por parte',
		text: 'Empieza en la sala, con la pregunta que me hicieron en mi defensa. Sin presentaciones.',
		body: [
			'Sabes qué has puesto. Lo que cuesta es explicar por qué está ahí y no en otro sitio.',
			'En el vídeo te enseño el orden que hace que cada decisión tenga respuesta.',
		],
	},
	{
		tag: 'PDF · 20 min',
		title: '¿Tu programación aguanta el por qué?',
		text: 'Cada ítem es una pregunta del tribunal. Tres casillas, y la del medio es la que duele.',
	},
	{
		tag: 'PDF · 1 página',
		title: 'El mapa, para imprimir',
		text: 'Una página: cada parte, su decisión y la pregunta que aguanta.',
	},
];
const [video, ...pdfs] = deliverables;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title} description={description} noindex />
	</head>
	<body>
		<Header width={1008} />
		<main class="landing">
			<div class="hero">
				<section class="pitch">
					<p class="brand-label">para opositores de FP · vídeo de 6 minutos</p>
					<h1>
						El orden en que se construye una programación de FP que aguanta cada «por qué» del
						tribunal.
					</h1>
					<p class="brand-lead">
						Te enseño cómo se hace una programación, parte por parte: qué decides en cada una y qué pregunta 
						del tribunal tiene que aguantar. Después coges la tuya, le dedicas 20 minutos y ves qué
						apartados defenderías y en cuáles acabarías citando la ley.
					</p>
					<p class="brand-label">9,6 · la mejor nota de mi especialidad en la Comunitat Valenciana, 2025</p>

					<form
						class="brand-optin"
						action={`https://app.kit.com/forms/${KIT_FORM_ID}/subscriptions`}
						method="post"
					>
						<label for="email-a">¿A qué correo te lo mando?</label>
						<div class="brand-optin-row">
							<input
								class="brand-input"
								id="email-a"
								name="email_address"
								type="email"
								placeholder="tucorreo@ejemplo.com"
								autocomplete="email"
								required
							/>
							<button class="brand-button" type="submit">Mándamelo</button>
						</div>
						<p class="brand-optin-note">
							Confirmas tu email y te llega en un minuto. Después, cada martes, una de esas decisiones a fondo. Si no te
							sirve, te das de baja con un
							clic. <a href="/politica-privacidad/">Política de privacidad</a>.
						</p>
					</form>
				</section>
				<TrackRecord compact class="proof" />
			</div>

			<section class="deliverables">
				<h2>Lo que te llega al correo</h2>
				<div class="cards">
					<div class="card card-featured">
						<p class="card-tag">{video.tag}</p>
						<h3 class="card-title">{video.title}</h3>
						<p class="card-text">{video.text}</p>
						{video.body?.map((paragraph) => <p class="card-body">{paragraph}</p>)}
					</div>
					<div class="cards-side">
						{
							pdfs.map((item) => (
								<div class="card">
									<p class="card-tag">{item.tag}</p>
									<h3 class="card-title">{item.title}</h3>
									<p class="card-text">{item.text}</p>
								</div>
							))
						}
					</div>
				</div>
				<p class="closing">
					No es una plantilla ni una programación para copiar. La que vas a defender es la tuya, y
					tiene que sonar a ti.
				</p>
				<p class="back-to-form">
					<a class="brand-button brand-button--secondary" href="#email-a">Quiero los tres <span aria-hidden="true">↑</span></a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
